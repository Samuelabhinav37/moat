{
  "name": "moat",
  "version": "0.11.138",
  "private": true,
  "license": "GPL-3.0",
  "description": "A quiet ad blocker and popup/redirect firewall for Chrome and Firefox.",
  "homepage": "https://samuelabhinav37.github.io/moat/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samuelabhinav37/moat.git"
  },
  "bugs": {
    "url": "https://github.com/Samuelabhinav37/moat/issues"
  },
  "type": "module",
  "scripts": {
    "dev:chrome": "node scripts/build.mjs chrome --watch",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "filters:update": "node scripts/update-filters.mjs && node scripts/update-cosmetics.mjs && node scripts/vendor-consent-rules.mjs && node scripts/vendor-cname-list.mjs && node scripts/update-live-manifest.mjs && node scripts/validate-rules.mjs",
    "validate:rules": "node scripts/validate-rules.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:firefox": "web-ext lint --source-dir=dist/firefox",
    "zip": "node scripts/zip.mjs",
    "check:chrome-load": "node scripts/check-chrome-load.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@adguard/dnr-rulesets": "^4.0.20260823030056",
    "@ghostery/trackerdb": "^1.0.923",
    "@puppeteer/browsers": "^3.2.3",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
